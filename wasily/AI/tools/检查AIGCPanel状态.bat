@echo off
chcp 65001 >nul
title 检查 AIGCPanel 状态
powershell -NoProfile -ExecutionPolicy Bypass -Command "$cfg=Join-Path $env:APPDATA 'aigcpanel\data\config.json'; if(!(Test-Path $cfg)){Write-Host '未找到配置，AIGCPanel 可能尚未启动过';pause;exit}; $j=Get-Content $cfg -Raw|ConvertFrom-Json; $port=$j.httpServerPort; $tok=$j.httpServerToken; $running=(Get-Process AigcPanel -ErrorAction SilentlyContinue|Measure-Object).Count; Write-Host ('进程数：'+$running); Write-Host ('端口：'+$port); if($running -gt 0){ try{ $r=Invoke-RestMethod -Uri ('http://127.0.0.1:'+$port+'/api/model/list') -Method POST -ContentType 'application/json' -Body '{}' -Headers @{Authorization=('Bearer '+$tok)} -TimeoutSec 8; $n=($r.data|Measure-Object).Count; Write-Host ('已安装模型数：'+$n); if($n -eq 0){Write-Host '尚无模型，请在软件「模型管理」中下载一键运行包（需登录 aigcpanel.com 账号）'}else{$r.data|ForEach-Object{Write-Host (' - '+$_.title+'  '+$_.id)}} }catch{ Write-Host ('接口无响应：'+$_.Exception.Message) } } else { Write-Host 'AIGCPanel 未运行，请先双击「启动AIGCPanel.bat」' }; pause"
