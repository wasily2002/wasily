  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a737d", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#a8d08d" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#e8e8e8" } },
    { "scope": ["variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f14c4c" } }
  ]
}
