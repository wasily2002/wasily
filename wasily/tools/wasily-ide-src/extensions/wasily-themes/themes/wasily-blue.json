    "gitDecoration.untrackedResourceForeground": "#73c991"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f7d9c", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#9ddcae" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#f2c78a" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#9db8ff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7fc4ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#ffd479" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#dce7f5" } },
    { "scope": ["variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "#8fd6ff" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#8fd6ff" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff6b6b" } }
  ]
}
