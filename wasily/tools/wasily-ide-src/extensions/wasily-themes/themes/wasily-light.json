    "gitDecoration.deletedResourceForeground": "#d93026",
    "gitDecoration.untrackedResourceForeground": "#1a7f37"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a919c", "fontStyle": "italic" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#1a7f37" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#b7791f" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#a626a4" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#2563eb" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#8a5a00" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#1f2329" } },
    { "scope": ["variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "#0f766e" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#0f766e" } },
    { "scope": ["invalid"], "settings": { "foreground": "#d93026" } }
  ]
}
